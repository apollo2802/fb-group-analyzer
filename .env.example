# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_ALLOW_CLOUD=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# URL der Facebook-Zielgruppe (z.B. https://www.facebook.com/groups/1234567890)
FB_GROUP_URL=https://www.facebook.com/groups/DEINE_GRUPPE

# Pfad zum persistenten Browser-Profil
FB_SESSION_DIR=./fb_session

# Pfad zur SQLite-Datenbank
DB_PATH=./state.db

# Scraper-Einstellungen
HEADLESS=true
SCROLL_COUNT=8
SCROLL_DELAY_SECONDS=3.0

# Scheduler-Intervall in Minuten (zufällig zwischen MIN und MAX für natürliches Verhalten)
CHECK_INTERVAL_MIN_MINUTES=15
CHECK_INTERVAL_MAX_MINUTES=30

# Dispatcher-Ziele
CSV_OUTPUT_PATH=./activities.csv
WEBHOOK_URL=
